      "type": "text",
      "x": 1544.1882263830826,
      "y": -294.2634252128703,
      "width": 447.47159174330136,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
