      "versionNonce": 1961161183,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763408487689,
      "link": null,
      "locked": false,
      "text": "Fournir en début de session un fichier css qui\npermet de metrre en forme rapidement les\ndifférents éléments (effet wahou).\n\n\nEnsuite, les apprenants modifient le css en\nfonction d'un design system définit en amont.\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fournir en début de session un fichier css qui permet de metrre en forme rapidement les différents éléments (effet wahou).\n\n\nEnsuite, les apprenants modifient le css en fonction d'un design system définit en amont.\n\n\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
